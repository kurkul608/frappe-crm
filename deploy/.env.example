# Переменные для деплоя через Komodo (или локально: cp .env.example .env).
# Реальные значения задаются в окружении деплой-системы и в git не попадают.

# --- Обязательные ---
# Домен и одновременно имя сайта Frappe; на него же настроен Traefik-роутер.
CRM_SITE_NAME=crm.example.com
CRM_DB_ROOT_PASSWORD=change-me
CRM_ADMIN_PASSWORD=change-me

# --- Опциональные (значения по умолчанию) ---
# Тег собираемого образа.
#CRM_IMAGE_TAG=latest
# Поднять значение, чтобы форсировать пересборку с новым кодом приложения
# (слой bench init кешируется докером).
#CRM_CACHE_BUST=1
# Версии рантаймов (согласованы с frappe version-15).
#FRAPPE_BRANCH=version-15
#PYTHON_VERSION=3.11.9
#NODE_VERSION=20
# Интеграция с Traefik на хосте.
#TRAEFIK_NETWORK=proxy
#TRAEFIK_ENTRYPOINT=websecure
#TRAEFIK_CERTRESOLVER=letsencrypt
